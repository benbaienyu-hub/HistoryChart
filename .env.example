# Copy to .env and paste your key to turn on the AI features.
#
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
#
# This is read ONLY by the server-side route in server/knowledgeRoutes.js.
# It deliberately has no VITE_ prefix, so Vite will never inline it into the
# browser bundle. Never rename it to VITE_ANTHROPIC_API_KEY — that would ship
# your key to every visitor.
#
# .env is gitignored. Don't commit it.
ANTHROPIC_API_KEY=sk-ant-...
